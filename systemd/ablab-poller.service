[Unit]
Description=AI Benchmark Lab runner poller (scripted fixtures only)
Documentation=https://github.com/simaan5/a-lab-harness
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitBurst=8
StartLimitIntervalSec=120

[Service]
Type=simple
# No EnvironmentFile: the poller reads /etc/ablab/poller.env itself, so ABL_TOKEN never sits
# in the process environment that children inherit.
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/lib/ablab-runner/bin/ablab-poller
Restart=on-failure
RestartSec=5
User=ablab
Group=ablab
WorkingDirectory=/var/lib/ablab-runner
UMask=0077
# NoNewPrivileges must stay off: the poller escalates only via the sudoers rule
# in /etc/sudoers.d/ablab-poller (four trusted helpers).
ProtectSystem=strict
ReadWritePaths=/var/lib/ablab-runner
PrivateTmp=true
ProtectHome=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
