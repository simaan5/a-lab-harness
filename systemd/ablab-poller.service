[Unit]
Description=AI Benchmark Lab runner poller (scripted fixtures only)
Documentation=https://github.com/simaan5/a-lab-harness
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
StartLimitBurst=8
StartLimitIntervalSec=120

[Service]
Type=simple
EnvironmentFile=/etc/ablab/poller.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/lib/ablab-runner/bin/ablab-poller
Restart=on-failure
RestartSec=5
User=root
Group=root
WorkingDirectory=/var/lib/ablab-runner
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
