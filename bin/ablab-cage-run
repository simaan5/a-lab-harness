#!/usr/bin/env bash
# Enforced isolated docker run for AI Benchmark Lab.
# ALLOWLIST: only the options below are accepted. Everything else is rejected.
# Hard isolation flags are appended AFTER caller options so they always win.
# Workloads never get a host shell, docker CLI, or docker.sock.
set -euo pipefail
ROOT="/var/lib/ablab-runner"
LOCK="${ROOT}/config/images.lock"
SECCOMP="${ROOT}/config/seccomp-default.json"

reject() { echo "REJECTED: $*" >&2; exit 2; }

# realpath of the host side; must be an existing direct child of $1 (no symlinks, no ..)
child_of() {
  local base="$1" src="$2" real
  case "$src" in *..*|*//*) return 1 ;; esac
  [ -d "$src" ] && [ ! -L "$src" ] || return 1
  real="$(realpath -e -- "$src")" || return 1
  [ "$real" = "$src" ] || return 1
  [ "$(dirname -- "$real")" = "$base" ] || return 1
  [ -n "$(basename -- "$real")" ]
}

check_volume() {
  local spec="$1" src dst mode
  IFS=: read -r src dst mode <<<"$spec"
  [ -n "$src" ] && [ -n "$dst" ] || return 1
  [ "$(printf '%s' "$spec" | tr -cd ':' | wc -c)" -le 2 ] || return 1
  case "$dst" in
    /workspace)
      case "${mode:-rw}" in rw|ro) ;; *) return 1 ;; esac
      child_of "${ROOT}/workspaces" "$src" ;;
    /trusted)
      [ "$mode" = "ro" ] && [ "$src" = "${ROOT}/trusted" ] && [ ! -L "$src" ] ;;
    /secret)
      [ "$mode" = "ro" ] && child_of "${ROOT}/run/secrets" "$src" ;;
    /sock)
      case "${mode:-rw}" in rw|ro) ;; *) return 1 ;; esac
      child_of "${ROOT}/run/sock" "$src" ;;
    *) return 1 ;;
  esac
}

image_allowed() {
  [ -f "$LOCK" ] || return 1
  awk -F= '!/^#/ && NF==2 {print $2}' "$LOCK" | grep -qxF -- "$1"
}

opts=()
image=""
while [ "$#" -gt 0 ]; do
  a="$1"
  case "$a" in
    --rm|-d) opts+=("$a"); shift ;;
    --name)
      [ "$#" -ge 2 ] || reject "--name needs a value"
      [[ "$2" =~ ^ablab-att-[A-Za-z0-9_-]{1,96}$ ]] || reject "container name $2"
      opts+=(--name "$2"); shift 2 ;;
    -w)
      [ "$#" -ge 2 ] || reject "-w needs a value"
      case "$2" in /workspace|/trusted) ;; *) reject "workdir $2" ;; esac
      opts+=(-w "$2"); shift 2 ;;
    -e)
      [ "$#" -ge 2 ] || reject "-e needs a value"
      [[ "$2" =~ ^ABL_SOCK=/sock/[a-z]+\.sock$ ]] || reject "env $2 (only ABL_SOCK=/sock/<name>.sock)"
      opts+=(-e "$2"); shift 2 ;;
    -v)
      [ "$#" -ge 2 ] || reject "-v needs a value"
      check_volume "$2" || reject "bind $2 is forbidden in the cage"
      opts+=(-v "$2"); shift 2 ;;
    -*) reject "$a is not on the cage allowlist" ;;
    *) image="$a"; shift; break ;;
  esac
done
[ -n "$image" ] || reject "no image given"
image_allowed "$image" || reject "image $image is not digest-pinned in $LOCK"
[ -f "$SECCOMP" ] || reject "seccomp profile $SECCOMP missing"

# Hard flags LAST (after caller options) so they cannot be overridden.
exec docker run \
  "${opts[@]}" \
  --network none \
  --cap-drop ALL \
  --security-opt no-new-privileges:true \
  --security-opt "seccomp=${SECCOMP}" \
  --user 65534:65534 \
  --init \
  --pids-limit 256 \
  --memory 2g \
  --memory-swap 2g \
  --cpus 2 \
  --ulimit nofile=1024:1024 \
  --ulimit core=0:0 \
  --ulimit fsize=268435456:268435456 \
  --read-only \
  --tmpfs /tmp:rw,nosuid,nodev,noexec,size=256m \
  --tmpfs /run:rw,nosuid,nodev,noexec,size=16m \
  --env HOME=/tmp \
  -- "$image" "$@"
