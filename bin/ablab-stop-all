#!/usr/bin/env bash
set -euo pipefail
ROOT="/var/lib/ablab-runner"
mkdir -p "$ROOT/run"
date -u +%Y-%m-%dT%H:%M:%SZ > "$ROOT/run/STOP_ALL"
# Cancel scripted fixture containers only.
ids="$(docker ps -aq --filter name=ablab-att- || true)"
if [ -n "$ids" ]; then
  docker stop -t 2 $ids >/dev/null 2>&1 || true
  docker rm -f $ids >/dev/null 2>&1 || true
fi
echo "STOP ALL set. Scripted fixture containers terminated."
echo "VERIFIED FOR SCRIPTED FIXTURE EXECUTION ONLY"
