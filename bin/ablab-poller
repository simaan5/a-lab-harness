#!/usr/bin/env python3
"""Outbound poller: a-lab -> control plane. Scripted fixtures only. No agents."""
from __future__ import annotations

import json
import os
import platform
import socket
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path("/var/lib/ablab-runner")
ENVF = Path("/etc/ablab/poller.env")
STOP_FLAG = ROOT / "run" / "STOP_ALL"
ALLOWED = {
    "good",
    "noop",
    "test_fail",
    "build_fail",
    "false_claim",
    "delete_test",
    "modify_protected",
    "hardcode",
    "secret_leak",
    "network",
    "host_read",
    "host_write",
    "child_process",
    "timeout",
    "crash",
    "bad_claim",
    "memory",
    "pidbomb",
    "tamper_verifier",
}
PROTOCOL = "ablab.runner.v1"


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


OPENER = urllib.request.build_opener(
    NoRedirect(),
    urllib.request.HTTPSHandler(context=ssl.create_default_context()),
)


def log(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def die(msg: str, code: int = 1) -> None:
    log(msg)
    raise SystemExit(code)


def load_env() -> dict[str, str]:
    if not ENVF.is_file():
        die(f"Missing {ENVF} (ABL_BASE_URL and ABL_TOKEN)")
    if ENVF.stat().st_mode & 0o077:
        die(f"{ENVF} must be mode 0600")
    data: dict[str, str] = {}
    for line in ENVF.read_text().splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        k, v = line.split("=", 1)
        data[k.strip()] = v.strip().strip('"').strip("'")
    return data


def redact(s: str, token: str) -> str:
    out = s.replace(token, "[REDACTED]")
    while "ablab_rt_" in out:
        i = out.find("ablab_rt_")
        j = i + 9
        while j < len(out) and out[j] in "0123456789abcdefABCDEF":
            j += 1
        out = out[:i] + "[REDACTED]" + out[j:]
    return out


def parse_body(raw: str) -> dict:
    if not raw:
        return {}
    try:
        data = json.loads(raw)
        return data if isinstance(data, dict) else {"error": "non_object"}
    except json.JSONDecodeError:
        return {"error": "non_json", "body": raw[:160].replace("\n", " ")}


def api(base: str, token: str, path: str, payload: dict | None = None, method: str = "POST") -> tuple[int, dict]:
    url = base.rstrip("/") + path
    body = None if method == "GET" else json.dumps(payload or {}).encode()
    req = urllib.request.Request(
        url,
        data=body,
        method=method,
        headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
            "Accept": "application/json",
            "User-Agent": "curl/8.5.0",
        },
    )
    try:
        with OPENER.open(req, timeout=20) as resp:
            raw = resp.read().decode("utf-8", "replace")
            return resp.status, parse_body(raw)
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8", "replace")
        parsed = parse_body(raw)
        loc = e.headers.get("Location") if e.headers else None
        if loc:
            parsed["location"] = loc.split("?")[0]
        return e.code, parsed
    except ssl.SSLError as e:
        die(f"TLS failure talking to {base}: {e}. Do not disable certificate verification.")
    except urllib.error.URLError as e:
        log(f"control plane unreachable: {e}")
        return 0, {"error": "unreachable"}
    except TimeoutError as e:
        log(f"control plane timeout: {e}")
        return 0, {"error": "timeout"}


def sh(cmd: list[str], timeout: float = 3) -> str:
    try:
        return subprocess.check_output(cmd, text=True, stderr=subprocess.DEVNULL, timeout=timeout).strip()
    except Exception:
        return "unknown"


def identity(busy: bool) -> dict:
    commit = (ROOT / "INSTALLED_COMMIT").read_text().strip() if (ROOT / "INSTALLED_COMMIT").is_file() else "unknown"
    ver = (ROOT / "INSTALLED_VERSION").read_text().strip() if (ROOT / "INSTALLED_VERSION").is_file() else "unknown"
    return {
        "protocol_version": PROTOCOL,
        "hostname": socket.gethostname(),
        "os": f"{platform.system()} {platform.release()}",
        "arch": platform.machine(),
        "cpu": sh(["nproc"]),
        "runner_software_version": "ablab-poller 5.4",
        "harness_version": ver,
        "harness_commit": commit,
        "docker_version": sh(["docker", "version", "--format", "{{.Server.Version}}"]),
        "cage_path": "/usr/local/bin/ablab-cage-run",
        "supported_fixtures": sorted(ALLOWED),
        "busy": busy,
        "agents": "not_integrated",
    }


def load_json(path: Path) -> dict:
    if not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def supervise_attempt(base: str, token: str, job_id: str, worker: str, timeout: int) -> dict:
    """Run attempt without blocking heartbeat. Cancel uses trusted local tool only."""
    env = os.environ.copy()
    env["ABL_JOB_ID"] = job_id
    proc = subprocess.Popen(
        [str(ROOT / "bin" / "ablab-run-attempt"), worker, str(timeout)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
        start_new_session=True,
    )
    cancel_observed_at: str | None = None
    while proc.poll() is None:
        code, hb = api(base, token, "/api/runner/heartbeat", identity(True))
        ids = set((hb or {}).get("cancel_job_ids") or []) if code == 200 else set()
        if job_id in ids:
            if cancel_observed_at is None:
                cancel_observed_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
                log(f"cancel observed job={job_id} at={cancel_observed_at}")
            subprocess.run([str(ROOT / "bin" / "ablab-cancel-attempt"), job_id], check=False)
        time.sleep(2)
    stdout, stderr = proc.communicate()
    lines = (stdout or "").strip().splitlines()
    parsed: dict = {}
    if lines:
        try:
            parsed = json.loads(lines[-1])
        except json.JSONDecodeError:
            parsed = {}
    evid = Path(str(parsed.get("evidence_dir") or ""))
    result = load_json(evid / "result.json") if evid else {}
    if not result:
        result = {
            "kind": "HARNESS_TEST",
            "model": None,
            "status": parsed.get("status") or "ERROR",
            "attempt_id": parsed.get("attempt_id") or parsed.get("attempt"),
        }
    result["kind"] = "HARNESS_TEST"
    result["model"] = None
    if cancel_observed_at:
        result["cancelled"] = True
        result["timeout"] = False
        result["cancel_observed_at"] = cancel_observed_at
        result["status"] = "CANCELLED"
    result["_evidence_dir"] = str(evid)
    result["_stderr"] = (stderr or "")[-4000:]
    return result


def post_artifacts(base: str, token: str, job_id: str, result: dict) -> None:
    evid = Path(str(result.pop("_evidence_dir", "") or ""))
    api(base, token, "/api/runner/events", {"job_id": job_id, "seq": 2, "kind": "COLLECTED", "payload": {"attempt": result.get("attempt_id")}})
    stdout = ""
    if evid.is_dir():
        stdout_path = evid / "stdout.txt"
        if stdout_path.is_file():
            stdout = redact(stdout_path.read_text(errors="replace")[:60_000], token)
        for kind, name in (
            ("result", "result.json"),
            ("verified", "verified.json"),
            ("score", "score.json"),
            ("manifest", "manifest.json"),
            ("claim", "claim.parsed.json"),
        ):
            payload = load_json(evid / name)
            if payload:
                api(base, token, "/api/runner/evidence", {"job_id": job_id, "kind": kind, "payload": payload})
                if kind == "score":
                    result["score"] = payload
                if kind == "verified":
                    result["verified"] = payload
    if stdout:
        api(base, token, "/api/runner/logs", {"job_id": job_id, "seq": 1, "body": stdout})
    result.pop("_stderr", None)
    api(base, token, "/api/runner/complete", {"job_id": job_id, "result": result})
    api(base, token, "/api/runner/cleanup", {"job_id": job_id, "kind": "job"})


def main() -> None:
    if socket.gethostname() != "a-lab":
        die(f"refusing to run on {socket.gethostname()}; expected a-lab")
    env = load_env()
    base = env.get("ABL_BASE_URL", "").rstrip("/")
    token = env.get("ABL_TOKEN", "")
    if not base or not token:
        die("ABL_BASE_URL and ABL_TOKEN required")
    if not base.startswith("https://"):
        die("BLOCKED — STABLE HTTPS CONTROL-PLANE ENDPOINT REQUIRED")
    if token.startswith("sk-") or "anthropic" in token.lower() or "openai" in token.lower():
        die("Refusing provider/model API keys in poller.env")
    log("ablab-poller 5.4 starting. Agents are not integrated.")
    log(f"base={base}")
    busy = False
    last_hb_log = 0.0
    while True:
        if STOP_FLAG.is_file() and not busy:
            log("local STOP_ALL flag present; heartbeat only, not claiming")
            api(base, token, "/api/runner/heartbeat", identity(True))
            time.sleep(5)
            continue
        ident = identity(busy)
        code, hb = api(base, token, "/api/runner/heartbeat", ident)
        now = time.time()
        if now - last_hb_log > 15 or code != 200:
            log(f"heartbeat http={code} ok={hb.get('ok')!r} error={hb.get('error')!r} body={str(hb)[:180]!r}")
            last_hb_log = now
        if code == 401:
            log("heartbeat unauthorized (credential rejected)")
            time.sleep(8)
            continue
        if code == 409:
            log("incompatible protocol")
            time.sleep(15)
            continue
        if code != 200:
            time.sleep(5)
            continue
        if hb.get("stop_all"):
            subprocess.run([str(ROOT / "bin" / "ablab-stop-all")], check=False)
            api(base, token, "/api/runner/cleanup", {"kind": "stop_all"})
            busy = False
            time.sleep(2)
            continue
        cancels = set(hb.get("cancel_job_ids") or [])
        code, claimed = api(base, token, "/api/runner/claim", {"protocol_version": PROTOCOL})
        job = (claimed or {}).get("job") if code == 200 else None
        if code != 200:
            log(f"claim http={code} error={claimed.get('error')!r}")
            time.sleep(4)
            continue
        if not job:
            time.sleep(3)
            continue
        job_id = job.get("id")
        worker = str(job.get("worker_id") or "")
        log(f"claimed {job_id} worker={worker}")
        if worker not in ALLOWED or job.get("kind") != "HARNESS_TEST":
            api(base, token, "/api/runner/complete", {"job_id": job_id, "result": {"kind": "HARNESS_TEST", "model": None}, "error": "unknown_fixture"})
            continue
        if job_id in cancels:
            api(base, token, "/api/runner/complete", {"job_id": job_id, "result": {"kind": "HARNESS_TEST", "model": None, "cancelled": True}})
            continue
        busy = True
        api(base, token, "/api/runner/events", {"job_id": job_id, "seq": 1, "kind": "CLAIMED", "payload": {"worker": worker}})
        timeout = 30 if worker != "timeout" else 8
        if worker == "memory":
            timeout = 25
        if worker == "child_process":
            timeout = 90
        result = supervise_attempt(base, token, job_id, worker, timeout)
        log(f"attempt done job={job_id} status={result.get('status')!r} cancelled={result.get('cancelled')!r}")
        post_artifacts(base, token, job_id, result)
        busy = False
        time.sleep(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        raise SystemExit(0)
