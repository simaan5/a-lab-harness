#!/usr/bin/env bash
# Lifecycle: ALLOCATING → PREPARING → READY → EXECUTING → COLLECTING → VERIFYING → CLEANING → DESTROYED
# Usage: ablab-run-attempt <worker> [timeout_secs] [job_id]
# stdout: ONE JSON object (last/only line). Everything else is stderr.
set +e
set -u
. /var/lib/ablab-runner/lib/common.sh
need_host
umask 0077

WORKER_ID="${1:?worker id e.g. good}"
TIMEOUT_SECS="${2:-}"
JOB_ID="${3:-${ABL_JOB_ID:-}}"
KEEP="${ABL_KEEP_WORKSPACE:-0}"
SECRET="${ABL_TEST_SECRET:-}"
unset ABL_TOKEN ABL_BASE_URL

if [[ ! "$WORKER_ID" =~ ^[a-z_]{1,32}$ ]]; then
  printf '{"attempt":"","attempt_id":"","status":"ERROR","error":"bad_worker_id"}\n'; exit 2
fi
if [ -n "$JOB_ID" ] && [[ ! "$JOB_ID" =~ ^[A-Za-z0-9_-]{1,128}$ ]]; then
  printf '{"attempt":"","attempt_id":"","status":"ERROR","error":"bad_job_id"}\n'; exit 2
fi
if ! needs_verify="$(worker_field "$WORKER_ID" verify)"; then
  echo "ERROR: unknown worker $WORKER_ID (not in manifest)" >&2
  printf '{"attempt":"","attempt_id":"","status":"ERROR","error":"unknown_worker"}\n'; exit 2
fi
needs_secret="$(worker_field "$WORKER_ID" secret)"
mount_launcher="$(worker_field "$WORKER_ID" mount_launcher)"
if [ "$needs_secret" = "true" ] && [ -z "$SECRET" ]; then
  SECRET="ABL_TEST_SECRET_$(openssl rand -hex 12)"   # synthetic, per attempt
fi
[ -n "$TIMEOUT_SECS" ] || TIMEOUT_SECS="$(worker_field "$WORKER_ID" timeout)"
[[ "$TIMEOUT_SECS" =~ ^[0-9]{1,4}$ ]] || TIMEOUT_SECS=30

ATT="t$(date +%s%N)$(openssl rand -hex 4 2>/dev/null || printf '%04x%04x' "$RANDOM" "$RANDOM")"
WS="${WS_ROOT}/${ATT}"
EV="${EVID_ROOT}/${ATT}"
SEC="${SECRETS_ROOT}/${ATT}"
NAME="ablab-att-${ATT}"
mkdir -p "$WS" "$EV" "${ROOT}/run"
state() { printf '%s\n' "$1" >"$EV/state"; printf 'STATE %s %s\n' "$1" "$ATT" >&2; }

emit() {
  python3 - "$ATT" "$EV/result.json" "${1:-unknown}" <<'PY'
import json, os, sys
att, path, status = sys.argv[1], sys.argv[2], sys.argv[3]
print(json.dumps({"attempt": att, "attempt_id": att, "result_json": path,
                  "evidence_dir": os.path.dirname(path), "status": status}, separators=(",", ":")))
PY
}

if stop_all_requested; then
  printf '%s\n' "{\"attempt\":\"$ATT\",\"attempt_id\":\"$ATT\",\"state\":\"REFUSED_STOP_ALL\",\"kind\":\"HARNESS_TEST\",\"model\":null}" >"$EV/result.json"
  emit REFUSED_STOP_ALL
  exit 3
fi

state ALLOCATING
image_id="$(docker image inspect "$IMAGE" --format '{{.Id}}' 2>/dev/null || echo unknown)"
fixture_sha="$(sha_tree "$FIX_BASE")"
trusted_before="$(sha_tree "$FIX_TRUST")"
launcher_before="$(sha_tree "$LAUNCHER")"
verify_sha="$(python3 "$PY" sha "${ROOT}/bin/ablab-verify")"
cage_sha="$(python3 "$PY" sha /usr/local/bin/ablab-cage-run 2>/dev/null || echo missing)"
start_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
manifest="${EV}/manifest.json"

state PREPARING
cp -a "$FIX_BASE"/. "$WS"/
mkdir -p "$WS/.ablab"
cp -a "${WORKERS}/${WORKER_ID}.mjs" "$WS/.ablab/worker.mjs"
chown_for_cage "$WS"
extra=()
if [ "$needs_secret" = "true" ] && [ -n "$SECRET" ]; then
  mkdir -p "$SEC"
  printf '%s' "$SECRET" >"$SEC/ABL_TEST_SECRET"
  chmod 0400 "$SEC/ABL_TEST_SECRET"; chmod 0500 "$SEC"
  chown_for_cage "$SEC"
  extra+=(-v "${SEC}:/secret:ro")
fi
# Hidden tests (/trusted) are never mounted into the worker container; the cage refuses it.
if [ "$mount_launcher" = "true" ]; then
  extra+=(-v "${LAUNCHER}:/launcher:ro")
fi

state READY
if [ -n "$JOB_ID" ]; then
  mkdir -p "${ROOT}/run/active"
  printf 'ATT=%s\nNAME=%s\nPID=%s\n' "$ATT" "$NAME" "$$" >"${ROOT}/run/active/${JOB_ID}"
fi
cat >"$manifest" <<EOF2
{
  "attempt": "${ATT}",
  "kind": "HARNESS_TEST",
  "model": null,
  "harness_version": "$(cat "${ROOT}/VERSION" 2>/dev/null || echo unknown)",
  "fixture_id": "health-service",
  "fixture_sha": "${fixture_sha}",
  "trusted_sha": "${trusted_before}",
  "launcher_sha": "${launcher_before}",
  "verify_sha": "${verify_sha}",
  "cage_sha": "${cage_sha}",
  "worker_id": "${WORKER_ID}",
  "image": "${IMAGE}",
  "image_id": "${image_id}",
  "network": "none",
  "userns_remap": "$(userns_mode)",
  "user": "65534:65534",
  "memory": "2g",
  "memory_swap": "2g",
  "cpus": "2",
  "pids_limit": 256,
  "seccomp": "config/seccomp-default.json",
  "secret_mounted": $([ ${#extra[@]} -gt 0 ] && [ "$needs_secret" = true ] && echo true || echo false),
  "trusted_mounted": false,
  "launcher_mounted": $([ "$mount_launcher" = true ] && echo true || echo false),
  "workspace": "${WS}",
  "container": "${NAME}",
  "timeout_secs": ${TIMEOUT_SECS},
  "start": "${start_iso}"
}
EOF2

state EXECUTING
timeout_hit=0
cancelled=0
oom_killed=false
exec_rc=-1
start_s=$(date +%s)
if "$CAGE" --name "$NAME" -d -v "${WS}:/workspace:rw" "${extra[@]}" -w /workspace \
    "$IMAGE" node /workspace/.ablab/worker.mjs >"$EV/container_id" 2>"$EV/cage.err"; then
  wait_out="$(timeout "$TIMEOUT_SECS" docker wait "$NAME" 2>/dev/null)"
  wrc=$?
  if [ "$wrc" -eq 124 ]; then
    timeout_hit=1
    docker kill "$NAME" >/dev/null 2>&1
    docker wait "$NAME" >/dev/null 2>&1
  fi
  exec_rc="$(docker inspect "$NAME" --format '{{.State.ExitCode}}' 2>/dev/null || echo "${wait_out:--1}")"
  oom_killed="$(docker inspect "$NAME" --format '{{.State.OOMKilled}}' 2>/dev/null || echo false)"
  docker logs "$NAME" >"$EV/stdout.raw" 2>"$EV/stderr.raw"
  for f in stdout.raw stderr.raw; do
    if [ "$(stat -c %s "$EV/$f")" -gt 1048576 ]; then
      head -c 1048576 "$EV/$f" >"$EV/$f.cut" && mv "$EV/$f.cut" "$EV/$f"
      echo "[ablab: truncated at 1 MiB]" >>"$EV/$f"
    fi
  done
else
  exec_rc=-2
  cp "$EV/cage.err" "$EV/stderr.raw"; : >"$EV/stdout.raw"
fi
end_s=$(date +%s)
if [ -f "${ROOT}/run/cancel-${ATT}" ] || { [ -n "$JOB_ID" ] && [ -f "${ROOT}/run/cancel-job-${JOB_ID}" ]; }; then
  cancelled=1
fi
if stop_all_requested; then
  cancelled=1
fi
# Precedence: cancelled > oom > timeout. Never more than one is true.
if [ "$cancelled" -eq 1 ]; then
  timeout_hit=0; oom_killed=false
elif [ "$oom_killed" = "true" ]; then
  timeout_hit=0
fi
docker rm -f "$NAME" >/dev/null 2>&1
end_iso="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

state COLLECTING
python3 "$PY" redact "$EV/stdout.raw" "$EV/stdout.txt" "$SECRET" >/dev/null 2>&1
python3 "$PY" redact "$EV/stderr.raw" "$EV/stderr.txt" "$SECRET" >/dev/null 2>&1
rm -f "$EV/stdout.raw" "$EV/stderr.raw" "$EV/cage.err"
claim="$WS/.ablab/claim.json"
if [ -L "$claim" ]; then
  printf '%s\n' '{"valid": false, "error": "symlink_claim", "claim": null}' >"$EV/claim.parsed.json"
elif [ -f "$claim" ]; then
  head -c 65537 "$claim" >"$EV/claim.raw.json"
  python3 "$PY" parse-claim "$EV/claim.raw.json" "$EV/claim.parsed.json" >/dev/null 2>&1
else
  printf '%s\n' '{"valid": false, "error": "missing_claim", "claim": null}' >"$EV/claim.parsed.json"
fi

state VERIFYING
verify_timeout=0
if [ "$needs_verify" = "true" ] && [ "$cancelled" -eq 0 ]; then
  timeout -k 10 "$VERIFY_TIMEOUT_SECS" /var/lib/ablab-runner/bin/ablab-verify "$ATT" >"$EV/verify.out" 2>&1
  vrc=$?
  if [ "$vrc" -eq 124 ] || [ "$vrc" -eq 137 ]; then
    verify_timeout=1
    echo "[ablab: verifier killed after ${VERIFY_TIMEOUT_SECS}s]" >>"$EV/verify.out"
    rm -f "$EV/verified.json"
  fi
fi
if [ "$verify_timeout" -eq 1 ]; then
  printf '%s\n' '{"build_passed": false, "visible_passed": false, "hidden_passed": false, "tests_passed": false, "task_complete": false, "protected_ok": null, "verifier_timeout": true}' >"$EV/verified.json"
elif [ ! -f "$EV/verified.json" ]; then
  printf '%s\n' '{"build_passed": false, "visible_passed": false, "hidden_passed": false, "tests_passed": false, "task_complete": false, "protected_ok": null, "skipped_software_verifier": true}' >"$EV/verified.json"
fi

constraint=0
python3 -c 'import json,sys; sys.exit(1 if json.load(open(sys.argv[1])).get("protected_ok") is False else 0)' "$EV/verified.json" || constraint=1

state CLEANING
docker rm -f "$NAME" "${NAME}-vbuild" "${NAME}-vsrv" "${NAME}-vvis" "${NAME}-vhid" >/dev/null 2>&1
[ -n "$JOB_ID" ] && rm -f "${ROOT}/run/active/${JOB_ID}"
rm -rf "${WS_ROOT}/${ATT}-verify" "${SOCK_ROOT:?}/${ATT}" "$SEC"
canary_ok=1
if [ -f /etc/ablab/HOST_CANARY.txt ]; then
  grep -qx "HOST_SECRET_CANARY_DO_NOT_LEAK" /etc/ablab/HOST_CANARY.txt || canary_ok=0
fi
trusted_after="$(sha_tree "$FIX_TRUST")"
launcher_after="$(sha_tree "$LAUNCHER")"
cleanup_ok=1
if [ "$KEEP" != "1" ]; then
  rm -rf "$WS"
  state DESTROYED
else
  state RETAINED_DEBUG
fi
[ "$KEEP" = "1" ] || [ ! -d "$WS" ] || cleanup_ok=0
[ ! -d "$SEC" ] || cleanup_ok=0
leftover="$(docker ps -aq --filter name="$NAME" 2>/dev/null | wc -l)"
[ "$leftover" -eq 0 ] || cleanup_ok=0

python3 "$PY" finalize "$EV/verified.json" "$EV/claim.parsed.json" "$cleanup_ok" "$constraint" "$EV/score.json" >/dev/null 2>&1

python3 - "$EV/result.json" "$ATT" "$WORKER_ID" "$EV/state" "$exec_rc" "$timeout_hit" "$cancelled" "$oom_killed" \
  "$cleanup_ok" "$canary_ok" "$((end_s - start_s))" "$start_iso" "$end_iso" "$KEEP" "$WS" "$trusted_before" "$trusted_after" "$verify_timeout" "$launcher_before" "$launcher_after" <<'PY'
import json, os, sys
(path, att, worker, statef, rc, to, canc, oom, clean, canary, dur, start, end, keep, ws, tb, ta, vto, lb, la) = sys.argv[1:]
doc = {
  "attempt": att, "attempt_id": att, "worker_id": worker,
  "kind": "HARNESS_TEST", "model": None, "ranking_eligible": False,
  "state": open(statef).read().strip() if os.path.exists(statef) else "UNKNOWN",
  "exit_status": int(rc), "timeout": to == "1", "cancelled": canc == "1", "oom_killed": oom == "true",
  "verify_timeout": vto == "1",
  "cleanup_ok": clean == "1", "host_canary_intact": canary == "1",
  "trusted_sha_before": tb, "trusted_sha_after": ta, "trusted_intact": tb == ta and lb == la,
  "duration_s": int(dur), "start": start, "end": end,
  "workspace_destroyed": (not os.path.isdir(ws)) if keep != "1" else False,
}
with open(path, "w", encoding="utf-8") as f:
    json.dump(doc, f, indent=2)
    f.write("\n")
PY

# Redact every evidence file (all encodings of the synthetic secret, runner tokens).
python3 "$PY" redact-dir "$EV" "$SECRET" "$EV/redaction.meta.json" >/dev/null 2>&1

# Non-root poller (group ablab) may read evidence; nobody else can.
if getent group ablab >/dev/null 2>&1; then
  chgrp -R ablab "$EV" && chmod -R g+rX,o-rwx "$EV"
fi

out_status="$(cat "$EV/state" 2>/dev/null || echo UNKNOWN)"
[ "$cancelled" -eq 1 ] && out_status="CANCELLED"
emit "$out_status"
exit 0
