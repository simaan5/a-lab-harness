#!/usr/bin/env bash
set -euo pipefail
ROOT="/var/lib/ablab-runner"
reaped=0
ids="$(docker ps -aq --filter name=ablab-att- || true)"
if [ -n "$ids" ]; then
  docker rm -f $ids >/dev/null 2>&1 || true
  reaped=1
fi
if [ -d "$ROOT/workspaces" ]; then
  for d in "$ROOT/workspaces"/*; do
    [ -d "$d" ] || continue
    rm -rf "$d"
    reaped=1
  done
fi
echo "{\"orphan_cleanup\":\"done\",\"had_orphans\":$reaped,\"success_not_assumed\":true}"
