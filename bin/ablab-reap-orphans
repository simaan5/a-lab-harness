#!/usr/bin/env bash
set -euo pipefail
ROOT="/var/lib/ablab-runner"
reaped=0
ids="$(docker ps -aq --filter name=ablab-att- || true)"
if [ -n "$ids" ]; then
  # shellcheck disable=SC2086
  docker rm -f $ids >/dev/null 2>&1 || true
  reaped=1
fi
for base in "$ROOT/workspaces" "$ROOT/run/secrets" "$ROOT/run/sock"; do
  [ -d "$base" ] || continue
  for d in "$base"/*; do
    [ -d "$d" ] || continue
    rm -rf -- "$d"
    reaped=1
  done
done
echo "{\"orphan_cleanup\":\"done\",\"had_orphans\":$reaped,\"success_not_assumed\":true}"
